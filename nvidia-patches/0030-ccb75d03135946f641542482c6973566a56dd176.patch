diff --git a/docker/Dockerfile b/docker/Dockerfile
index d7823f321154..1ada544280a6 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -650,7 +650,6 @@ RUN apt-get update -y \
         software-properties-common \
         curl \
         sudo \
-        ffmpeg \
         libsm6 \
         libxext6 \
         libgl1 \
@@ -705,6 +704,26 @@ RUN CUDA_VERSION_DASH=$(echo $CUDA_VERSION | cut -d. -f1,2 | tr '.' '-') && \
     apt-get install -y --no-install-recommends --allow-change-held-packages libnccl-dev=${NCCL_VER} libnccl2=${NCCL_VER} && \
     rm -rf /var/lib/apt/lists/*
 
+# Build and install codec-safe FFmpeg (no H.264, H.265/HEVC, or AAC).
+# See tools/build-ffmpeg-safe.sh for the exact configure flags.
+# strip-opencv-bundled-codecs.sh and verify-ffmpeg-safe.sh are also copied
+# here but kept until after the vLLM install so they can be re-invoked to
+# strip the FFmpeg libs that opencv-python-headless wheels bundle.
+COPY tools/build-ffmpeg-safe.sh /tmp/build-ffmpeg-safe.sh
+COPY tools/verify-ffmpeg-safe.sh /tmp/verify-ffmpeg-safe.sh
+COPY tools/strip-opencv-bundled-codecs.sh /tmp/strip-opencv-bundled-codecs.sh
+RUN bash /tmp/build-ffmpeg-safe.sh \
+    && bash /tmp/verify-ffmpeg-safe.sh \
+    && FFMPEG_VERSION=5.1.6 FFMPEG_PREFIX=/opt/ffmpeg-safe-cv2-shim-v5 \
+        bash /tmp/build-ffmpeg-safe.sh \
+    && FFMPEG_VERSION=8.0.2 FFMPEG_PREFIX=/opt/ffmpeg-safe-cv2-shim-v8 \
+        bash /tmp/build-ffmpeg-safe.sh \
+    && rm /tmp/build-ffmpeg-safe.sh \
+    && rm -rf /var/lib/apt/lists/*
+ENV PATH=/opt/ffmpeg-safe/bin:$PATH
+ENV LD_LIBRARY_PATH=/opt/ffmpeg-safe/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
+ENV PKG_CONFIG_PATH=/opt/ffmpeg-safe/lib/pkgconfig:$PKG_CONFIG_PATH
+
 # Install uv for faster pip installs
 RUN python3 -m pip install uv
 
@@ -873,6 +892,13 @@ RUN --mount=type=cache,target=/opt/uv/cache \
 . /etc/environment && \
 uv pip list
 
+# Strip the FFmpeg shared libraries that opencv-python-headless wheels bundle
+# (private libavcodec containing H.264/HEVC/AAC) and re-verify the image is
+# codec-safe end-to-end. Must run after the vLLM pip install above.
+RUN bash /tmp/strip-opencv-bundled-codecs.sh \
+    && bash /tmp/verify-ffmpeg-safe.sh \
+    && rm /tmp/strip-opencv-bundled-codecs.sh /tmp/verify-ffmpeg-safe.sh
+
 # Pytorch now installs NVSHMEM, setting LD_LIBRARY_PATH
 ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
 
diff --git a/docker/Dockerfile.cpu b/docker/Dockerfile.cpu
index 61bad68b4425..d56d3395d797 100644
--- a/docker/Dockerfile.cpu
+++ b/docker/Dockerfile.cpu
@@ -30,15 +30,35 @@ ARG PIP_EXTRA_INDEX_URL="https://download.pytorch.org/whl/cpu"
 ARG max_jobs=32
 ENV MAX_JOBS=${max_jobs}
 
-# Install minimal dependencies and uv
+# Install minimal dependencies and uv. `ffmpeg` was removed from this
+# apt list as part of the royalty-bearing codec audit; the codec-safe
+# FFmpeg replacement is built in the RUN block below.
 RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
     --mount=type=cache,target=/var/lib/apt,sharing=locked \
     apt-get update -y \
     && apt-get install -y --no-install-recommends sudo ccache git curl wget ca-certificates zlib1g-dev \
-    gcc-12 g++-12 libtcmalloc-minimal4 libnuma-dev ffmpeg libsm6 libxext6 libgl1 jq lsof make xz-utils \
+    gcc-12 g++-12 libtcmalloc-minimal4 libnuma-dev libsm6 libxext6 libgl1 jq lsof make xz-utils \
     && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 10 --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
     && curl -LsSf https://astral.sh/uv/install.sh | sh
 
+# Build and install codec-safe FFmpeg (no H.264, H.265/HEVC, or AAC).
+# verify-ffmpeg-safe.sh and strip-opencv-bundled-codecs.sh are retained at
+# /tmp so they can be re-invoked after pip installs (to strip the FFmpeg
+# libs that opencv-python-headless wheels bundle).
+COPY tools/build-ffmpeg-safe.sh /tmp/build-ffmpeg-safe.sh
+COPY tools/verify-ffmpeg-safe.sh /tmp/verify-ffmpeg-safe.sh
+COPY tools/strip-opencv-bundled-codecs.sh /tmp/strip-opencv-bundled-codecs.sh
+RUN bash /tmp/build-ffmpeg-safe.sh \
+    && bash /tmp/verify-ffmpeg-safe.sh \
+    && FFMPEG_VERSION=5.1.6 FFMPEG_PREFIX=/opt/ffmpeg-safe-cv2-shim-v5 \
+        bash /tmp/build-ffmpeg-safe.sh \
+    && FFMPEG_VERSION=8.0.2 FFMPEG_PREFIX=/opt/ffmpeg-safe-cv2-shim-v8 \
+        bash /tmp/build-ffmpeg-safe.sh \
+    && rm /tmp/build-ffmpeg-safe.sh
+ENV PATH=/opt/ffmpeg-safe/bin:$PATH
+ENV LD_LIBRARY_PATH=/opt/ffmpeg-safe/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
+ENV PKG_CONFIG_PATH=/opt/ffmpeg-safe/lib/pkgconfig:$PKG_CONFIG_PATH
+
 # Compiler and linker environment
 ENV CC=/usr/bin/gcc-12 CXX=/usr/bin/g++-12
 ENV CCACHE_DIR=/root/.cache/ccache
@@ -294,6 +314,12 @@ RUN --mount=type=cache,target=/root/.cache/uv \
         uv pip install "$(realpath dist/*.whl)"; \
     fi
 
+# Strip the FFmpeg shared libraries that opencv-python-headless wheels bundle
+# (private libavcodec containing H.264/HEVC/AAC) and re-verify the image is
+# codec-safe end-to-end. Must run after the vLLM pip install above.
+RUN bash /tmp/strip-opencv-bundled-codecs.sh \
+    && bash /tmp/verify-ffmpeg-safe.sh
+
 # Add labels to document build configuration
 LABEL org.opencontainers.image.title="vLLM CPU"
 LABEL org.opencontainers.image.description="vLLM inference engine for CPU platforms"
@@ -327,4 +353,11 @@ RUN if [ "$TARGETARCH" != "amd64" ]; then \
 RUN --mount=type=cache,target=/root/.cache/uv \
     uv pip install "vllm[zen]"
 
+# Strip the FFmpeg shared libraries that opencv-python-headless wheels bundle
+# (private libavcodec containing H.264/HEVC/AAC) and re-verify the image is
+# codec-safe end-to-end. Must run after the vLLM pip install above.
+RUN bash /tmp/strip-opencv-bundled-codecs.sh \
+    && bash /tmp/verify-ffmpeg-safe.sh \
+    && rm /tmp/strip-opencv-bundled-codecs.sh /tmp/verify-ffmpeg-safe.sh
+
 ENTRYPOINT ["vllm", "serve"]
