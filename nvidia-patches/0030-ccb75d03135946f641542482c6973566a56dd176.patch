 tools/build-ffmpeg-safe.sh                    | 209 ++++++++++++++++++
 tools/strip-opencv-bundled-codecs.sh          | 194 ++++++++++++++++
 tools/verify-ffmpeg-safe.sh                   | 140 ++++++++++++
 vllm/assets/video.py                          |   4 +-
 .../speech_to_text/transcription/protocol.py  |   6 +-
