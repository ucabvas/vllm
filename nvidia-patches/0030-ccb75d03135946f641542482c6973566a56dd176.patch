 requirements/common.txt                       |   8 +
 requirements/test/cuda.in                     |   3 +-
 requirements/test/cuda.txt                    |   8 +-
 requirements/test/rocm.in                     |   3 +-
 requirements/test/rocm.txt                    |  10 +-
 requirements/test/xpu.txt                     |   4 +-
 setup.py                                      |   1 -
 .../multimodal/processing/test_glm4_1v.py     |   2 +-
 tests/multimodal/media/test_audio.py          |  11 +-
