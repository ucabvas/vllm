+COPY tools/verify-ffmpeg-safe.sh /tmp/verify-ffmpeg-safe.sh
+COPY tools/strip-opencv-bundled-codecs.sh /tmp/strip-opencv-bundled-codecs.sh
+RUN bash /tmp/build-ffmpeg-safe.sh \
